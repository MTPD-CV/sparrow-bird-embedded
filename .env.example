# API Keys
UNSPLASH_API_KEY=your_unsplash_access_key_here
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Hardware Configuration (RPi 3)
ESP32_URL=http://192.168.1.100
CAMERA_SRC=0  # Use 0 for webcam, or path to video file (e.g., sparow.mp4)

# Model Configuration
MODEL_PATH=best_ncnn_int8  # Folder output export NCNN
CONF_THRESHOLD=0.45
INFER_IMGSZ=320

# Optimization & Control
TRIGGER_DELAY_S=3.0
INFER_INTERVAL_S=0.1  # Frame skipping: deteksi tiap 100ms (10 FPS)
